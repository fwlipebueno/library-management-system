{
  "openapi": "3.0.3",
  "info": {
    "title": "API da Biblioteca",
    "version": "1.0.0",
    "description": "Sistema Web de Gerenciamento de Biblioteca. Autentique-se e use Authorize com o token. Contas fictícias e execução no README."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual da API"
    }
  ],
  "tags": [
    {
      "name": "Autenticação"
    },
    {
      "name": "Livros"
    },
    {
      "name": "Usuários"
    },
    {
      "name": "Empréstimos"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autenticar usuário ativo",
        "security": [],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sessao"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Emite JWT HS256 por 1 hora e retorna dados sem hash. Perfil enviado pelo cliente é ignorado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          }
        }
      }
    },
    "/livros": {
      "get": {
        "tags": [
          "Livros"
        ],
        "summary": "Listar e pesquisar livros ativos",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Livro"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Pesquisa por título e/ou autor. Quando ambos são informados, os dois devem corresponder.",
        "parameters": [
          {
            "name": "titulo",
            "in": "query",
            "required": false,
            "description": "Trecho literal, sem distinguir maiúsculas/minúsculas. Vazio é ignorado.",
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          },
          {
            "name": "autor",
            "in": "query",
            "required": false,
            "description": "Trecho literal, sem distinguir maiúsculas/minúsculas. Vazio é ignorado.",
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Livros"
        ],
        "summary": "Cadastrar livro (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Livro"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "ISBN único, inclusive entre livros excluídos. Disponibilidade inicial igual ao total. Não envie quantidadeDisponivel.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LivroEntrada"
              }
            }
          }
        }
      }
    },
    "/livros/{id}": {
      "get": {
        "tags": [
          "Livros"
        ],
        "summary": "Consultar livro ativo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Livro"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ]
      },
      "put": {
        "tags": [
          "Livros"
        ],
        "summary": "Editar livro (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Livro"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Envie todos os campos editáveis. Disponibilidade calculada pelo servidor sob lock. Não envie quantidadeDisponivel. Total inferior aos exemplares emprestados ou ISBN duplicado retorna 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LivroEntrada"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ]
      },
      "delete": {
        "tags": [
          "Livros"
        ],
        "summary": "Excluir livro do catálogo (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Operação concluída."
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Exclusão lógica (ativo=false). Empréstimo ativo impede a exclusão com 409. Histórico preservado. Sem corpo na resposta 204.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ]
      }
    },
    "/usuarios": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Listar contas ativas e desativadas (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Usuario"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        }
      },
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Cadastrar usuário (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Não há cadastro público. Email normalizado em minúsculas e único. Senha armazenada com bcrypt; hash nunca é retornado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastro"
              }
            }
          }
        }
      }
    },
    "/usuarios/{id}": {
      "put": {
        "tags": [
          "Usuários"
        ],
        "summary": "Editar ou ativar/desativar usuário (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Envie nome, email, perfil e ativo. Omitir senha mantém o hash atual; senha enviada deve ser não vazia e recebe novo hash. Cada requisição protegida consulta o perfil e a ativação atuais no banco.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioEdicao"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ]
      }
    },
    "/emprestimos": {
      "get": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Consultar todos os empréstimos (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Emprestimo"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Retorna ativos e devolvidos, inclusive de livros excluídos e contas desativadas."
      },
      "post": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Registrar empréstimo (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Emprestimo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Exige usuário ativo, livro ativo e disponibilidade positiva. Transação bloqueia a linha do livro antes de verificar e decrementar. Conta desativada ou falta de exemplar retorna 409. Data de empréstimo e status são definidos pelo servidor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmprestimoEntrada"
              }
            }
          }
        }
      }
    },
    "/emprestimos/meus": {
      "get": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Consultar o próprio histórico",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Emprestimo"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Usa exclusivamente a identidade autenticada. Ignora usuarioId enviado pelo cliente. Inclui empréstimos ativos e devolvidos de ambos os perfis."
      }
    },
    "/emprestimos/{id}/devolucao": {
      "patch": {
        "tags": [
          "Empréstimos"
        ],
        "summary": "Registrar devolução (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Emprestimo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Erro400"
          },
          "401": {
            "$ref": "#/components/responses/Erro401"
          },
          "403": {
            "$ref": "#/components/responses/Erro403"
          },
          "404": {
            "$ref": "#/components/responses/Erro404"
          },
          "409": {
            "$ref": "#/components/responses/Erro409"
          },
          "500": {
            "$ref": "#/components/responses/Erro500"
          }
        },
        "description": "Não exige corpo. Transação bloqueia o empréstimo e o livro. Preenche a data no servidor, muda o status para devolvido e incrementa a disponibilidade. Devolução duplicada retorna 409.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT HS256 com expiração em 1 hora. Conta e perfil atuais verificados no banco."
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "required": [
          "erro",
          "codigo"
        ],
        "properties": {
          "erro": {
            "type": "string",
            "example": "Livro sem exemplares disponíveis para empréstimo."
          },
          "codigo": {
            "type": "string",
            "example": "LIVRO_INDISPONIVEL"
          }
        }
      },
      "Usuario": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "email",
          "perfil",
          "ativo"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "usuario@biblioteca.test"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "admin",
              "usuario"
            ]
          },
          "ativo": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "UsuarioCadastro": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "perfil",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "usuario@biblioteca.test"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "admin",
              "usuario"
            ]
          },
          "ativo": {
            "type": "boolean",
            "default": true
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "description": "Senha com pelo menos um caractere não branco, limitada pelo servidor a 72 bytes em UTF-8."
          }
        }
      },
      "UsuarioEdicao": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "perfil",
          "ativo"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "usuario@biblioteca.test"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "admin",
              "usuario"
            ]
          },
          "ativo": {
            "type": "boolean",
            "example": true
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "description": "Senha com pelo menos um caractere não branco, limitada pelo servidor a 72 bytes em UTF-8."
          }
        }
      },
      "UsuarioResumo": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "usuario@biblioteca.test"
          }
        }
      },
      "LivroEntrada": {
        "type": "object",
        "required": [
          "titulo",
          "autor",
          "isbn",
          "ano",
          "quantidadeTotal"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "Dom Casmurro"
          },
          "autor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "Machado de Assis"
          },
          "isbn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "9788535914849"
          },
          "ano": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999,
            "example": 1899
          },
          "quantidadeTotal": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647,
            "example": 1
          }
        }
      },
      "Livro": {
        "type": "object",
        "required": [
          "id",
          "titulo",
          "autor",
          "isbn",
          "ano",
          "quantidadeTotal",
          "quantidadeDisponivel",
          "ativo"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "Dom Casmurro"
          },
          "autor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "Machado de Assis"
          },
          "isbn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "9788535914849"
          },
          "ano": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999,
            "example": 1899
          },
          "quantidadeTotal": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647,
            "example": 1
          },
          "quantidadeDisponivel": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          },
          "ativo": {
            "type": "boolean"
          }
        }
      },
      "LoginEntrada": {
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "usuario@biblioteca.test"
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "description": "Senha com pelo menos um caractere não branco, limitada pelo servidor a 72 bytes em UTF-8."
          }
        }
      },
      "Sessao": {
        "type": "object",
        "required": [
          "token",
          "usuario"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT HS256 com validade de 1 hora."
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      },
      "EmprestimoEntrada": {
        "type": "object",
        "required": [
          "usuarioId",
          "livroId",
          "dataPrevista"
        ],
        "properties": {
          "usuarioId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "livroId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "dataPrevista": {
            "type": "string",
            "format": "date",
            "example": "2026-12-04",
            "description": "Data real no formato AAAA-MM-DD, entre os anos 0001 e 9999."
          }
        }
      },
      "Emprestimo": {
        "type": "object",
        "required": [
          "id",
          "usuarioId",
          "livroId",
          "dataEmprestimo",
          "dataPrevista",
          "dataDevolucao",
          "status",
          "usuario",
          "livro"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "usuarioId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "livroId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "dataEmprestimo": {
            "type": "string",
            "format": "date-time",
            "description": "Definida pelo servidor."
          },
          "dataPrevista": {
            "type": "string",
            "format": "date"
          },
          "dataDevolucao": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ativo",
              "devolvido"
            ]
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioResumo"
          },
          "livro": {
            "$ref": "#/components/schemas/Livro"
          }
        }
      }
    },
    "responses": {
      "Erro400": {
        "description": "Dados, JSON, identificador ou parâmetros inválidos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro401": {
        "description": "Credenciais inválidas; token ausente, inválido ou expirado; conta desativada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro403": {
        "description": "O perfil atual do usuário não é administrador.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro404": {
        "description": "Recurso não encontrado. Livros excluídos também retornam 404.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro409": {
        "description": "Conflito de estado, duplicidade ou indisponibilidade.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      },
      "Erro500": {
        "description": "Falha inesperada. A resposta não expõe detalhes internos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            }
          }
        }
      }
    }
  }
}
